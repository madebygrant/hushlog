{
  "name": "hushlog",
  "version": "1.2.2",
  "type": "module",
  "description": "Styled console logging for development environments",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "release": "gh workflow run 'Publish to npm' -f version=patch",
    "release:minor": "gh workflow run 'Publish to npm' -f version=minor",
    "release:major": "gh workflow run 'Publish to npm' -f version=major",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.27.3"
  },
  "keywords": [
    "dev",
    "logger",
    "console",
    "debug",
    "hush",
    "hushlog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madebygrant/hushlog.git"
  },
  "homepage": "https://madebygrant.github.io/hushlog/"
}
